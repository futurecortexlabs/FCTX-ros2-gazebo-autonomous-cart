      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>front_left_joint</left_joint>
        <left_joint>rear_left_joint</left_joint>
        <right_joint>front_right_joint</right_joint>
        <right_joint>rear_right_joint</right_joint>
        <wheel_separation>0.68</wheel_separation>
        <wheel_radius>0.18</wheel_radius>
        <topic>/loop/cmd_vel</topic>
        <odom_topic>/loop/wheel_odom</odom_topic>
        <tf_topic>/loop/wheel_tf</tf_topic>
        <frame_id>wheel_odom</frame_id>
        <child_frame_id>loop_cart/base_link</child_frame_id>
        <max_linear_velocity>1.5</max_linear_velocity>
        <min_linear_velocity>-0.8</min_linear_velocity>
        <max_angular_velocity>1.5</max_angular_velocity>
        <min_angular_velocity>-1.5</min_angular_velocity>
        <max_linear_acceleration>1.2</max_linear_acceleration>
        <min_linear_acceleration>-2.5</min_linear_acceleration>
        <max_angular_acceleration>2.5</max_angular_acceleration>
        <min_angular_acceleration>-2.5</min_angular_acceleration>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_topic>/loop/ground_truth</odom_topic>
        <tf_topic>/loop/tf</tf_topic>
        <odom_frame>world</odom_frame>
        <robot_base_frame>loop_cart/base_link</robot_base_frame>
        <dimensions>3</dimensions>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
    </model>
    <model name="overview_camera">
      <static>true</static>
      <link name="camera_link">
        <pose>9 -12 15 0 0.7854 2.2143</pose>
        <sensor name="overview" type="camera">
          <topic>/loop/overview</topic>
          <update_rate>1</update_rate>
          <always_on>true</always_on>
          <camera>
